# Local default: no AWS credentials or Docker needed.
SHARE_PERSISTENCE=memory

# For an explicitly configured deployment:
# SHARE_PERSISTENCE=dynamodb
# DYNAMODB_TABLE_NAME=doorknob-dev-shares
# DYNAMODB_REGION=us-west-2
# The SDK uses the compute role through its default credential provider chain.

# Daily readings: one YAML catalog, loaded and cached by each service process.
READINGS_SOURCE=local
READINGS_SAMPLE=true
READINGS_LOCAL_PATH=infra/terraform/readings.example.yaml
# READINGS_SOURCE=s3
# READINGS_S3_BUCKET=your-private-readings-bucket
# READINGS_S3_KEY=just-for-today.yaml
# READINGS_REGION=us-west-2
