{
  "name": "doorknob",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test --test-isolation=none tests/shares/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run openapi:lint && npm test && npm run build",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "openapi:generate": "node --conditions=react-server --import tsx scripts/generate-openapi.ts",
    "openapi:lint": "npm run openapi:generate && spectral lint .tmp/openapi.yaml --ruleset .spectral.yaml --fail-severity warn"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "content-type": "^3.1.1",
    "hono": "^4.13.13",
    "next": "^16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@playwright/test": "^1.64.1",
    "@stoplight/spectral-cli": "^6.17.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "openapi-types": "^12.1.3",
    "openapi3-ts": "^4.6.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true
  }
}
