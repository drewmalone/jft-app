{
  "name": "doorknob",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit && npm run typecheck:relay",
    "typecheck:relay": "tsc -p tsconfig.relay.json",
    "test": "node --conditions=react-server --import tsx --import ./tests/shares/setup.ts --test --test-isolation=none tests/shares/*.test.ts tests/shares/transcription/*.test.ts && node --import tsx --test --test-isolation=none tests/shares/transcription/client/*.test.ts && node --import tsx --test --test-isolation=none tests/shares/cleanup/client/*.test.ts && node --import tsx --test tests/quality/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck:relay && npm run openapi:lint && npm test && npm run build",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "openapi:generate": "node --conditions=react-server --import tsx scripts/generate-openapi.ts",
    "openapi:lint": "npm run openapi:generate && spectral lint .tmp/openapi.yaml --ruleset .spectral.yaml --fail-severity warn"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/core": "3.978.5",
    "@hono/zod-openapi": "^1.6.3",
    "content-type": "^3.1.1",
    "hono": "^4.13.13",
    "next": "^16.4.3",
    "openai": "^7.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-textarea-autosize": "^8.5.9",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@stoplight/spectral-cli": "^6.17.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "openapi-types": "^12.1.3",
    "openapi3-ts": "^4.6.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true
  }
}
